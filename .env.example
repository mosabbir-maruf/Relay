# Server Configuration
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=60000

# Gateway Authentication (Optional Static Bearer Token)
# If unset or left blank, authentication is disabled (local development mode).
# When set, all /v1/* endpoints require "Authorization: Bearer <RELAY_API_KEY>".
# The /health endpoint always remains accessible without authentication.
# RELAY_API_KEY=your_relay_api_key_here

# Google Gemini Provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-2.5-pro,gemini-3.8-flash

# Generic OpenAI-Compatible Provider
# Supports any inference server providing OpenAI-compatible /v1/chat/completions:
# - Local / self-hosted: Ollama (http://localhost:11434/v1), vLLM (http://localhost:8000/v1), LM Studio (http://localhost:1234/v1)
# - Cloud / remote: Groq, OpenRouter, Together, OpenAI, Kaggle T4x2
# Note: For unauthenticated backends (e.g. Ollama, local vLLM), OPENAI_COMPATIBLE_API_KEY can be left blank or omitted.
#
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_NAME=openai-compatible
# OPENAI_COMPATIBLE_MODELS=llama3.2,mistral,qwen2.5-coder

# Generic vLLM Provider (OpenAI-compatible backend)
# Connects Relay directly to any self-hosted model running on vLLM (Qwen, GPT-2, GLM-OCR, Llama, etc.).
# For unauthenticated backends (such as local vLLM or standard self-hosted servers), VLLM_API_KEY is optional.
# Example local vLLM: VLLM_BASE_URL=http://localhost:8000/v1
# Example Kaggle Cloudflare Quick Tunnel (ephemeral development URL):
# VLLM_BASE_URL=https://<tunnel-subdomain>.trycloudflare.com/v1
#
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=gpt2
# VLLM_API_KEY=

# Legacy Qwen Provider (preserved for backward compatibility)
# Connects Relay directly to a self-hosted Qwen model.
# QWEN_BASE_URL=http://localhost:8000/v1
# QWEN_MODEL=qwen3-coder-30b
# QWEN_API_KEY=

# Rate Limiting Configuration (Process-Local In-Memory Limiter)
# Protects gateway compute and upstream provider quotas from burst floods.
# Note: Scope is process-local. Counters reset upon server restart.
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_KEY_STRATEGY=client_or_ip
# RATE_LIMIT_MAX_KEYS=10000

# Network & Reverse Proxy Security
# Set to true when running behind a trusted reverse proxy (Cloudflare, Nginx, AWS ALB).
# When false (default), X-Forwarded-For headers are ignored to prevent IP spoofing attacks.
# TRUST_PROXY=false

# Model Routing & Fallback Policies (JSON Array)
# Allows defining logical aliases and fallback chains for retryable failures (502/503/504/network drops).
# Non-retryable errors (400 invalid request, 401 auth, 429 rate limits, client cancellation) are never retried.
# ROUTING_POLICIES=[{"model":"fast-coder","primary":"qwen/qwen3-coder-30b","fallbacks":["gemini/gemini-2.5-flash"]}]

# Circuit Breaker Configuration
# Protects failing upstream providers and automatically skips them during outages.
# Qualifies 502/503/504 and network drops; ignores 400/401/429/client cancellation.
# CIRCUIT_BREAKER_ENABLED=false
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
# CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=1


